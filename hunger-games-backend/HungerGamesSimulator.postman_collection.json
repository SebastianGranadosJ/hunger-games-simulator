{
  "info": {
    "name": "Hunger Games Simulator",
    "_postman_id": "hgs-collection-2026",
    "description": "API collection for the Hunger Games AI Simulator.\n\nUso típico:\n1. Start (default tributes)\n2. Advance (repetir hasta is_over = true)\n3. Winner",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Simulation",
      "item": [
        {
          "name": "Start — Default Tributes",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"use_default_tributes\": true,\n  \"language\": \"English\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/simulation/start",
              "host": ["{{baseUrl}}"],
              "path": ["simulation", "start"]
            },
            "description": "Starts a new simulation with the 8 canonical tributes (Katniss, Peeta, Cato, Clove, Finnick, Glimmer, Marvel, Rue). Returns 400 if a simulation is already running."
          }
        },
        {
          "name": "Start — Custom Tributes",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"use_default_tributes\": false,\n  \"language\": \"Spanish\",\n  \"tributes\": [\n    { \"name\": \"Katniss Everdeen\", \"gender\": \"F\", \"district\": 12 },\n    { \"name\": \"Peeta Mellark\",    \"gender\": \"M\", \"district\": 12 },\n    { \"name\": \"Cato\",             \"gender\": \"M\", \"district\": 2  },\n    { \"name\": \"Clove\",            \"gender\": \"F\", \"district\": 2  }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/simulation/start",
              "host": ["{{baseUrl}}"],
              "path": ["simulation", "start"]
            },
            "description": "Starts a new simulation with a custom list of tributes. Requires at least 2 tributes. The language field sets the narrative language."
          }
        },
        {
          "name": "Advance Period",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/simulation/advance",
              "host": ["{{baseUrl}}"],
              "path": ["simulation", "advance"]
            },
            "description": "Runs one period (Bloodbath → Day 1 → Night 1 → Day 2 → …). Returns the event batch, is_over flag, and winner if the simulation ended. Returns 400 if no simulation is running or it is already over."
          }
        },
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/simulation/status",
              "host": ["{{baseUrl}}"],
              "path": ["simulation", "status"]
            },
            "description": "Returns the current period number, event type, and list of alive tributes."
          }
        },
        {
          "name": "Winner",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/simulation/winner",
              "host": ["{{baseUrl}}"],
              "path": ["simulation", "winner"]
            },
            "description": "Returns the winning tribute if the simulation is over, otherwise returns null."
          }
        },
        {
          "name": "Reset",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/simulation/reset",
              "host": ["{{baseUrl}}"],
              "path": ["simulation", "reset"]
            },
            "description": "Destroys the current simulator and clears global state. Always succeeds."
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "All Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/simulation/events",
              "host": ["{{baseUrl}}"],
              "path": ["simulation", "events"]
            },
            "description": "Returns the complete event history of the current simulation."
          }
        },
        {
          "name": "Events — Kills Only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/simulation/events?kills_only=true",
              "host": ["{{baseUrl}}"],
              "path": ["simulation", "events"],
              "query": [
                { "key": "kills_only", "value": "true" }
              ]
            },
            "description": "Returns only events that resulted in at least one death."
          }
        },
        {
          "name": "Events — By Period",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/simulation/events?period_number=1&event_type=day",
              "host": ["{{baseUrl}}"],
              "path": ["simulation", "events"],
              "query": [
                { "key": "period_number", "value": "1" },
                { "key": "event_type",    "value": "day" }
              ]
            },
            "description": "Filters events by period number and type. Valid event_type values: bloodbath, day, night."
          }
        },
        {
          "name": "Events — Bloodbath",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/simulation/events?event_type=bloodbath",
              "host": ["{{baseUrl}}"],
              "path": ["simulation", "events"],
              "query": [
                { "key": "event_type", "value": "bloodbath" }
              ]
            },
            "description": "Returns all events from the Bloodbath phase."
          }
        },
        {
          "name": "Events — By Tribute ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/simulation/events?tribute_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["simulation", "events"],
              "query": [
                { "key": "tribute_id", "value": "1", "description": "Replace with the tribute ID you want to filter by" }
              ]
            },
            "description": "Returns all events in which a specific tribute was involved. Tribute IDs are assigned sequentially starting from 1."
          }
        },
        {
          "name": "Events — Combined Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/simulation/events?period_number=1&event_type=night&kills_only=true",
              "host": ["{{baseUrl}}"],
              "path": ["simulation", "events"],
              "query": [
                { "key": "period_number", "value": "1" },
                { "key": "event_type",    "value": "night" },
                { "key": "kills_only",    "value": "true" }
              ]
            },
            "description": "All filters stack. This example returns kill events from Night 1."
          }
        }
      ]
    }
  ]
}
